{
  "entities": {
    "drugs": {
      "title": "Drugs",
      "description": "Drug monographs based on DDInter dataset",
      "properties": {
        "name": { "type": "string" },
        "genericName": { "type": "string" },
        "brandNames": { "type": "array", "items": { "type": "string" } },
        "atcCode": { "type": "string" },
        "category": { "type": "string" },
        "indication": { "type": "string" },
        "contraindications": { "type": "string" },
        "sideEffects": { "type": "string" },
        "dosage": { "type": "string" },
        "ddinterId": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "genericName"]
    },
    "interactions": {
      "title": "Interactions",
      "description": "Drug interaction pairs from DDInter dataset",
      "properties": {
        "drugA": { "type": "string" },
        "drugB": { "type": "string" },
        "severity": { "type": "string" },
        "mechanism": { "type": "string" },
        "management": { "type": "string" },
        "evidenceLevel": { "type": "string" },
        "ddinterPairId": { "type": "string" }
      },
      "required": ["drugA", "drugB", "severity"]
    },
    "users": {
      "title": "User Profiles",
      "description": "User profiles and subscription roles",
      "properties": {
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "subscriptionPlan": { "type": "string" },
        "subscriptionStatus": { "type": "string" },
        "expiresAt": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["email", "role"]
    },
    "history": {
      "title": "Interaction Checks History",
      "description": "Saved drug interaction checks by customers",
      "properties": {
        "userId": { "type": "string" },
        "drugs": { "type": "array", "items": { "type": "string" } },
        "timestamp": { "type": "string" },
        "interactionCount": { "type": "number" },
        "highestSeverity": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["userId", "drugs"]
    }
  }
}
